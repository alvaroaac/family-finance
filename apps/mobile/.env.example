# Public build-time values only. Never put service-role or AI keys in an Expo app.
EXPO_PUBLIC_API_URL=https://your-casa-dashboard.example
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Enables one-time-code connection for your existing account. Ignored in release builds.
EXPO_PUBLIC_DEVELOPMENT_MODE=false
EXPO_PUBLIC_DEVELOPMENT_EMAIL=
