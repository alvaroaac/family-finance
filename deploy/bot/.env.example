# deploy/bot/.env.example — Telegram bot container env (spec §3.5).
# Copy to `.env` on the VPS (chmod 600). NEVER commit the real file.

# Telegram
TELEGRAM_BOT_TOKEN=123456789:replace-with-botfather-token
# Random secret; must match the `secret_token` passed to setWebhook.
TELEGRAM_WEBHOOK_SECRET=replace-with-long-random-string

# Supabase (public HTTPS URL once Caddy is up; service-role key stays VPS-only)
SUPABASE_URL=https://supabase.alvaroekarol.com.br
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Message reading (unified classifier chain) + voice transcription (Whisper).
# With this key set the bot reads every text via OpenAI: OPENAI_MODEL (default
# gpt-6-luna, 4 s), then Claude below (5 s). Reasoning effort is `none`
# (apps/bot/src/index.ts) — eval showed no accuracy loss.
OPENAI_API_KEY=replace-with-openai-key
# Optional override; leave unset to take the default above. Set gpt-6-sol here
# if luna misreads messages in production.
OPENAI_MODEL=

# Last-resort message reading (Claude). Without OPENAI_API_KEY this is also the
# legacy categorizer + interpreter.
ANTHROPIC_API_KEY=replace-with-anthropic-key
# Optional — defaults to packages/config DEFAULT_ANTHROPIC_MODEL when unset.
ANTHROPIC_MODEL=claude-haiku-4-5

# Import categorization primary (Codex CLI, `codex login` into the named volume).
# Message reading no longer uses Codex. Reasoning effort is `low` (apps/bot/src/codex.ts).
CODEX_ENABLED=false
CODEX_MODEL=gpt-6-sol
CODEX_TIMEOUT_MS=12000

# Authenticates the web app's server-to-server import categorization requests.
# Use the same random value (32+ characters) in the web deployment.
IMPORT_SUGGESTION_SHARED_SECRET=replace-with-another-long-random-secret
# Operational Codex fallback only; deliberate Codex abstentions stay manual.
# Enabling requires provider=anthropic|openai plus an exact model id and the
# matching API key. Recommended evaluated choice: openai + gpt-5.4.
IMPORT_PAID_FALLBACK_ENABLED=false
IMPORT_PAID_FALLBACK_PROVIDER=
IMPORT_PAID_FALLBACK_MODEL=
IMPORT_PAID_FALLBACK_MAX_ITEMS=10

# Webhook server port (Caddy proxies bot.alvaroekarol.com.br → :8787)
PORT=8787
