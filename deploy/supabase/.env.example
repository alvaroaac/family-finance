# deploy/supabase/.env.example — OUR values for the official Supabase
# self-host stack (spec §4.1). This is NOT the full upstream template — start
# from the `.env.example` shipped in supabase/docker at the pinned tag and
# override/merge the variables below. Real `.env` lives on the VPS only,
# chmod 600, never committed.

############
# Secrets — generate fresh for prod, never reuse local demo values.
############

# openssl rand -base64 32 (min 32 chars)
POSTGRES_PASSWORD=replace-with-strong-password
# openssl rand -base64 48 (min 32 chars). ANON_KEY / SERVICE_ROLE_KEY are JWTs
# signed with this secret — mint them with the generator at
# https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
JWT_SECRET=replace-with-generated-jwt-secret
ANON_KEY=replace-with-anon-jwt
SERVICE_ROLE_KEY=replace-with-service-role-jwt
# Supabase Studio dashboard login (behind Kong basic auth)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace-with-strong-password
# openssl rand -base64 32 — required by newer stacks for storage/realtime
SECRET_KEY_BASE=replace-with-generated-secret
VAULT_ENC_KEY=replace-with-32-char-secret

############
# URLs — Caddy terminates HTTPS and proxies to Kong on localhost:8000.
############

# Where GoTrue redirects users after auth flows (the Vercel web app).
SITE_URL=https://<vercel-app-domain>
# Public API URL (what browsers/bot hit). Both point at the Caddy vhost.
API_EXTERNAL_URL=https://supabase.alvaroekarol.com.br
SUPABASE_PUBLIC_URL=https://supabase.alvaroekarol.com.br
# Extra allowed redirect targets (comma-separated), e.g. preview deploys.
ADDITIONAL_REDIRECT_URLS=

############
# Auth (GoTrue) — mirrors the working local supabase/config.toml.
############

DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
JWT_EXPIRY=3600

# Google OAuth (same client as local; add the prod redirect in Google console:
# https://supabase.alvaroekarol.com.br/auth/v1/callback)
GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=replace-with-google-client-id
GOTRUE_EXTERNAL_GOOGLE_SECRET=replace-with-google-client-secret
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=https://supabase.alvaroekarol.com.br/auth/v1/callback
# Local config.toml sets skip_nonce_check for Google sign-in; keep parity.
GOTRUE_EXTERNAL_GOOGLE_SKIP_NONCE_CHECK=true

############
# Kong — keep the gateway loopback-only; Caddy is the public face.
############

KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
