# deploy/bot/.env.example — Telegram bot container env (spec §3.5).
# Copy to `.env` on the VPS (chmod 600). NEVER commit the real file.

# Telegram
TELEGRAM_BOT_TOKEN=123456789:replace-with-botfather-token
# Random secret; must match the `secret_token` passed to setWebhook.
TELEGRAM_WEBHOOK_SECRET=replace-with-long-random-string

# Supabase (public HTTPS URL once Caddy is up; service-role key stays VPS-only)
SUPABASE_URL=https://supabase.alvaroekarol.com.br
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Voice transcription (Whisper)
OPENAI_API_KEY=replace-with-openai-key

# Categorization + free-text interpretation (Claude)
ANTHROPIC_API_KEY=replace-with-anthropic-key
# Optional — defaults to packages/config DEFAULT_ANTHROPIC_MODEL when unset.
ANTHROPIC_MODEL=claude-opus-4-8

# Webhook server port (Caddy proxies bot.alvaroekarol.com.br → :8787)
PORT=8787
