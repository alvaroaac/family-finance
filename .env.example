# --- Supabase (Auth + Postgres + RLS) ---
# Project URL and anon key power the browser/server clients. The service-role key
# is server-only and must never be exposed to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Public base URL of the web app, used to build the Google OAuth redirect target
# (e.g. http://localhost:3000 in dev, your Vercel URL in production).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google login ---
# Google OAuth is configured in the Supabase dashboard (Authentication > Providers
# > Google). These values are needed there; they are not read directly by the app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Access control ---
# Allowlist of authorized Google emails for the private Casa workspace.
# Comma/semicolon/space separated. Only these emails can reach the (app) routes.
# Example: AUTHORIZED_EMAILS=alvaro@example.com,karol@example.com
AUTHORIZED_EMAILS=

# Single MVP household workspace slug.
HOUSEHOLD_SLUG=casa

# --- Telegram bot ---
# Bot token from @BotFather; used as the Bot API base path to send replies.
TELEGRAM_BOT_TOKEN=
# Secret passed to setWebhook (?secret_token=...). Telegram echoes it back in the
# X-Telegram-Bot-Api-Secret-Token header on every webhook call; the handler
# verifies it and FAILS CLOSED when unset (no secret => every request rejected).
# Without these two the bot uses a no-op sender (local dry-run) and cannot accept
# webhooks.
#
# Voice notes: the bot downloads the Telegram voice/audio file to a TEMPORARY
# path, transcribes it, and DELETES the temp file immediately (even on error).
# Raw audio is NEVER persisted to disk or the database — only the transcribed
# text flows through the same confirmation flow as a typed message. Transcription
# requires TELEGRAM_BOT_TOKEN (to fetch the file) + OPENAI_API_KEY (below);
# without both, voice notes are politely rejected and the user is asked to type.
TELEGRAM_WEBHOOK_SECRET=

# --- AI providers ---
# LLM intent/field interpretation + categorization fallback. Default provider is
# Anthropic Claude (model claude-haiku-4-5). The interpreter runs for every new
# text message when configured; deterministic parsing still owns reliable amount
# and date fields, and memory/rules run before AI categorization. Every draft is
# shown for confirmation before it is saved. Leave empty to disable AI enrichment
# (the bot remains usable with deterministic parsing, rules, and memory).
ANTHROPIC_API_KEY=
# Optional override of the default Claude model id (claude-haiku-4-5).
ANTHROPIC_MODEL=

# Audio transcription provider key (e.g. OpenAI Whisper). Reused for voice-note
# transcription. Leave empty to disable audio entry.
OPENAI_API_KEY=

# Codex-first text/import interpretation on the bot VPS.
CODEX_ENABLED=false
CODEX_MODEL=gpt-5.5
CODEX_TIMEOUT_MS=12000

# --- Reliable imports ---
# Independent 32+ character secrets. The preview secret stays in the web app;
# the shared secret must match the bot deployment.
IMPORT_PREVIEW_SIGNING_SECRET=
IMPORT_SUGGESTION_URL=https://bot.example.com
IMPORT_SUGGESTION_SHARED_SECRET=
# Optional provider-neutral paid fallback for operational Codex failures.
# Disabled by default. Enabling requires an explicit provider and model; the
# currently supported paid provider is anthropic and uses ANTHROPIC_API_KEY.
IMPORT_PAID_FALLBACK_ENABLED=false
IMPORT_PAID_FALLBACK_PROVIDER=
IMPORT_PAID_FALLBACK_MODEL=
IMPORT_PAID_FALLBACK_MAX_ITEMS=10
