# --- Supabase (Auth + Postgres + RLS) ---
# Project URL and anon key power the browser/server clients. The service-role key
# is server-only and must never be exposed to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bot container may use this name instead of the browser public key.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Public base URL of the web app, used to build the Google OAuth redirect target
# (e.g. http://localhost:3000 in dev, your Vercel URL in production).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google login ---
# Google OAuth is configured in the Supabase dashboard (Authentication > Providers
# > Google). These values are needed there; they are not read directly by the app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Telegram bot ---
# Bot token from @BotFather; used as the Bot API base path to send replies.
TELEGRAM_BOT_TOKEN=
# Secret passed to setWebhook (?secret_token=...). Telegram echoes it back in the
# X-Telegram-Bot-Api-Secret-Token header on every webhook call; the handler
# verifies it and FAILS CLOSED when unset (no secret => every request rejected).
# Without these two the bot uses a no-op sender (local dry-run) and cannot accept
# webhooks.
#
# Voice notes: the bot downloads the Telegram voice/audio file to a TEMPORARY
# path, transcribes it, and DELETES the temp file immediately (even on error).
# Raw audio is NEVER persisted to disk or the database — only the transcribed
# text flows through the same confirmation flow as a typed message. Transcription
# requires TELEGRAM_BOT_TOKEN (to fetch the file) + OPENAI_API_KEY (below);
# without both, voice notes are politely rejected and the user is asked to type.
TELEGRAM_WEBHOOK_SECRET=

# --- AI providers ---
# Category selection: household memory/rules -> Jev -> GPT fallback.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=2500
# GPT extracts Telegram intent/amount/date/installments, supplies category
# fallback, and transcribes voice notes. Every draft requires confirmation.
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Reliable imports ---
# Independent 32+ character secrets. The preview secret stays in the web app;
# the shared secret must match the bot deployment.
IMPORT_PREVIEW_SIGNING_SECRET=
IMPORT_SUGGESTION_URL=https://bot.example.com
IMPORT_SUGGESTION_SHARED_SECRET=
# Bounded GPT fallback for Jev errors, uncertainty or taxonomy proposals.
# Enable on the bot VPS with OPENAI_API_KEY. Blank model uses OPENAI_MODEL
# or the current default gpt-6-luna. Intentional abstentions stay manual.
IMPORT_PAID_FALLBACK_ENABLED=false
IMPORT_PAID_FALLBACK_PROVIDER=openai
IMPORT_PAID_FALLBACK_MODEL=
IMPORT_PAID_FALLBACK_MAX_ITEMS=10
