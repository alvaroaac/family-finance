    </div>
    <div class="scrollbox" style="max-height: 300px;">
      <div class="row" style="grid-template-columns: 40px 56px minmax(0, 1fr) 100px 150px 150px 120px; border-top: none;"><span class="check check-on">✓</span><span class="num note">01/08</span><span><input class="input-sm" type="text" value="PAG*SUPERMERCADO" readonly></span><span class="amount">R$ 312,40</span><span class="select"><input class="input-sm" type="text" value="Mercado" readonly><span class="caret caret-sm">▼</span></span><span class="select"><input class="input-sm" type="text" value="Semanal" readonly><span class="caret caret-sm">▼</span></span><span></span></div>
      <div class="row" style="grid-template-columns: 40px 56px minmax(0, 1fr) 100px 150px 150px 120px;"><span class="check check-on">✓</span><span class="num note">02/08</span><span><input class="input-sm" type="text" value="UBER *TRIP" readonly></span><span class="amount">R$ 24,90</span><span class="select"><input class="input-sm sel-warn" type="text" value="escolher…" readonly><span class="caret caret-sm">▼</span></span><span class="select"><input class="input-sm" type="text" value="(nenhuma)" readonly style="opacity: 0.5;"><span class="caret caret-sm">▼</span></span><span style="text-align: right;"><button class="btn-link" type="button" style="font-size: 11px;">ir na fila ›</button></span></div>
      <div class="row" style="grid-template-columns: 40px 56px minmax(0, 1fr) 100px 150px 150px 120px; background: var(--ff-tint);"><span class="check check-on">✓</span><span class="num note">03/08</span><span><input class="input-sm" type="text" value="IFOOD *IFD" readonly></span><span class="amount">R$ 48,90</span><span class="select"><input class="input-sm" type="text" value="Alimentação" readonly style="opacity: 0.7;"><span class="caret caret-sm">▼</span></span><span class="select"><input class="input-sm" type="text" value="Delivery" readonly style="opacity: 0.7;"><span class="caret caret-sm">▼</span></span><span style="text-align: right;"><span class="badge badge-acc" style="font-size: 10px; padding: 2px 8px;">na fila agora</span></span></div>
      <div class="row" style="grid-template-columns: 40px 56px minmax(0, 1fr) 100px 150px 150px 120px;"><span class="check check-on">✓</span><span class="num note">04/08</span><span><input class="input-sm" type="text" value="POSTO SHELL VILA" readonly></span><span class="amount">R$ 200,00</span><span class="select"><input class="input-sm" type="text" value="Transporte" readonly><span class="caret caret-sm">▼</span></span><span class="select"><input class="input-sm" type="text" value="Combustível" readonly><span class="caret caret-sm">▼</span></span><span></span></div>
      <div class="row" style="grid-template-columns: 40px 56px minmax(0, 1fr) 100px 150px 150px 120px;"><span class="check check-on">✓</span><span class="num note">05/08</span><span><input class="input-sm" type="text" value="99APP *99" readonly></span><span class="amount">R$ 18,70</span><span class="select"><input class="input-sm sel-warn" type="text" value="escolher…" readonly><span class="caret caret-sm">▼</span></span><span class="select"><input class="input-sm" type="text" value="(nenhuma)" readonly style="opacity: 0.5;"><span class="caret caret-sm">▼</span></span><span style="text-align: right;"><button class="btn-link" type="button" style="font-size: 11px;">ir na fila ›</button></span></div>
