<div class="{{themeClass}}" style="width: 1092px; min-height: 0; box-sizing: border-box; background: var(--ff-bg); padding: 48px 56px; color: var(--ff-ink);">
<div style="max-width: 980px; margin: 0 auto; display: flex; flex-direction: column; gap: 24px;">
